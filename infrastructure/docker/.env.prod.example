# Gabarit du .env réel du VPS — copier en `.env` À CÔTÉ de docker-compose.prod.yml
# sur le VPS uniquement (jamais commité, voir .gitignore). Contrairement au
# .env.example racine (dev), il n'y a PAS de valeur par défaut ici pour les
# secrets : docker-compose.prod.yml plante volontairement si l'une de ces
# variables manque, plutôt que de retomber sur un mot de passe faible.

# Domaine de contact requis par Let's Encrypt (expiration de certificat, etc.)
ACME_EMAIL=toi@example.com

# Tag d'image à déployer = SHA du commit publié par la CI sur ghcr.io
# (voir Actions -> run correspondant). Redéployer = changer cette valeur puis
# `docker compose -f docker-compose.prod.yml pull && ... up -d`.
IMAGE_TAG=<sha-du-commit>

POSTGRES_USER=sporya
POSTGRES_PASSWORD=<mot-de-passe-généré-fort>
POSTGRES_DB=sporya

# Paire de clés RSA de PRODUCTION — générée sur le VPS (jamais celle de dev
# de .env.example à la racine), voir backend/api/README.md#clés-jwt-rs256.
JWT_PRIVATE_KEY_BASE64=<base64-clé-privée-pem>
JWT_PUBLIC_KEY_BASE64=<base64-clé-publique-pem>

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<mot-de-passe-généré-fort>
