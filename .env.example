# Copier ce fichier en `.env` (non commité) et adapter si besoin.
# Valeurs par défaut pensées pour le développement local uniquement.

POSTGRES_USER=sporya
POSTGRES_PASSWORD=sporya
POSTGRES_DB=sporya
POSTGRES_PORT=5432

ADMINER_PORT=8081

API_PORT=8080

# Paire de clés RSA de DEV UNIQUEMENT (générée pour ce repo, aucune donnée réelle
# à protéger derrière) — voir services/api/README.md pour en générer une autre.
# Ne JAMAIS réutiliser ces valeurs pour un déploiement réel (VPS : Secret K8s dédié).
JWT_PRIVATE_KEY_
JWT_PUBLIC_KEY_

